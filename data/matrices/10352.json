’une énorme tortue afin de créer une gigantesque ile.&nbsp;</p>"},{"id":"exelem_380a6bd9-69fd-4c7a-9775-70798550afef","type":"label","metrics":{"x":128,"y":299,"width":391,"fixed_width":"","height":23,"zindex":103},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">mythe &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; conte &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;légende</p>"},{"id":"exelem_d3d26c08-d5c9-4725-f9ed-d8ba87cbf58d","type":"checkbox","metrics":{"x":78,"y":290,"width":"40","height":"40","zindex":104},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_ba0dbc99-8f44-4ba5-ff1c-1b6c69b2929f","type":"checkbox","metrics":{"x":399,"y":289,"width":"40","height":"40","zindex":105},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_4c786182-4725-4c6d-e7b8-8854882db450","type":"checkbox","metrics":{"x":238,"y":288,"width":"40","height":"40","zindex":106},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"}]},"types":["Cases à cocher"],"theory":"","explanation":"","number":"10.5.4","displayLabel":"10.5.4 — Évaluation"},{"id":"115683","name":"M3_narr_eval_05","title":"<p><b>Vrai ou faux? Coche la bonne réponse.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_70ba2e03-2e93-4d1d-97fd-a402f1491c63","type":"checkbox","metrics":{"x":580,"y":307,"width":"40","height":"40","zindex":115},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"4"},{"id":"exelem_3e91b37b-7c2b-472d-87eb-63281ce55b8f","type":"checkbox","metrics":{"x":519,"y":307,"width":"40","height":"40","zindex":114},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"4"},{"id":"exelem_86aa4449-538c-4172-962a-51bc744