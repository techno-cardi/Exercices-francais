"left","html":true,"latex":false},"text":"<p style=\"color: rgb(17, 82, 120); font-family: Arial; font-size: 20px; font-weight: normal;\"><font size=\"14\" style=\"font-size:14px;\">Source : DESBORDES-VALMORE, Marceline (1973[1839]). Qu’en avez-vous fait?&nbsp;<i>Les œuvres poétiques</i>. Presses universitaires de Grenoble.</font></p>"},{"id":"exelem_69ee8d01-3d0e-465a-b312-302e7c0d6381","type":"label","metrics":{"x":370,"y":312,"width":37,"fixed_width":"","height":23,"zindex":105},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Non</p>"},{"id":"exelem_6f98c1f3-524a-4802-e49c-72cfe44005d4","type":"label","metrics":{"x":251,"y":310,"width":31,"fixed_width":"","height":23,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Oui</p>"},{"id":"exelem_60c66433-bcf9-4a7e-fd18-45879844d5af","type":"checkbox","metrics":{"x":320,"y":301,"width":"40","height":"40","zindex":103},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_a3111a24-d08b-4d84-c5aa-06988af866d4","type":"checkbox","metrics":{"x":201,"y":301,"width":"40","height":"40","zindex":102},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_e9d5db50-aecb-40c6-b1fd-aa5739e70b14","type":"label","metrics":{"x":211,"y":86,"width":188,"fixed_width":"","height":192,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Vous aviez mon cœur,</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Moi, j’avais le vôtre:</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Un cœur pour un cœur;</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Bonheur pour bonheur!</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Le vôtre est rendu,</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Je n’en ai plus d’autre,</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Le vôtre est rendu,</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Le mien est perdu!</font></p>"}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"118205","name":"M3_poetique_eval_07","title":"<font color=\"#FFFFFF\"><b>Indique si ce poème appartient au genre lyrique.</b></font>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_6b1f8a90-eb43-44f3-f7cb-8570d5d4e973","type":"label","metrics":{"x":75,"y":216,"width":500,"fixed_width":"500","height":19,"zindex":106},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p><font size=\"14\" style=\"font-size:14px;\">Source : VALÉRY, Paul (1927).&nbsp;La fileuse.&nbsp;<i>Album de vers anciens</i>. Gallimard.</font></p>"},{"id":"exelem_69ee8d01-3d0e-465a-b312-302e7c0d6381","type":"label","metrics":{"x":370,"y":312,"width":37,"fixed_width":"","height":23,"zindex":105},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Non</p>"},{"id":"exelem_6f98c1f3-524a-4802-e49c-72cfe44005d4","type":"label","metrics":{"x":251,"y":310,"width":31,"fixed_width":"","height":23,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Oui</p>"},{"id":"exelem_60c66433-bcf9-4a7e-fd18-45879844d5af","type":"checkbox","metrics":{"x":320,"y":301,"width":"40","height":"40","zindex":103},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_a3111a24-d08b-4d84-c5aa-06988af866d4","type":"checkbox","metrics":{"x":201,"y":301,"width":"40","height":"40","zindex":102},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_e9d5db50-aecb-40c6-b1fd-aa5739e70b14","type":"label","metrics":{"x":150,"y":86,"width":334,"fixed_width":"","height":144,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Assise, la fileuse au bleu de la croisée</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Où le jardin mélodieux se dodeline ;</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Le rouet ancien qui ronfle l’a grisée.</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Lasse, ayant bu l’azur, de filer la câline</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Chevelure, à ses doigts si faibles évasive,</font><o:p></o:p></p><p align=\"center\"><font size=\"18\" style=\"font-size:18px;\">Elle songe, et sa tête petite s’incline.</font><o:p></o:p></p>"}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"118206","name":"M3_poetique_eval_08","title":"<p><b>Replace les phrases dans l’ordre pour former des rimes plates.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_cf1ac0c2-9abc-4118-8c21-b502cf645a2f","type":"sorted_items","metrics":{"x":181,"y":101,"width":322,"height":206,"zindex":101},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"items_color":"default","vertical":true,"items":["L’hiver où j’ai regardé le lac gel