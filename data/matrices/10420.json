 neige.</span></p>"},{"id":"exelem_7d561238-368c-4f73-cfe7-41ab4eb91a1d","type":"dropdown_menu","metrics":{"x":150,"y":360,"width":"150","height":"32","zindex":106},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"selected_index":-1,"options":["comparaison","métaphore","gradation","répétition"],"menu_position":"top"},{"id":"exelem_8f9ba793-2ca1-41ca-ee79-ab6ad183d25a","type":"dropdown_menu","metrics":{"x":150,"y":270,"width":"150","height":"32","zindex":105},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"selected_index":-1,"options":["comparaison","métaphore","gradation","répétition"],"menu_position":"top"},{"id":"exelem_4d9b0e88-561c-44d6-e9cd-3b54aa1715c9","type":"dropdown_menu","metrics":{"x":150,"y":200,"width":"150","height":"32","zindex":104},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"selected_index":-1,"options":["comparaison","métaphore","gradation","répétition"],"menu_position":"top"},{"id":"exelem_f9d88bf2-ceae-422b-94e0-1cbddfc569c0","type":"dropdown_menu","metrics":{"x":150,"y":130,"width":"150","height":"32","zindex":103},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"selected_index":-1,"options":["comparaison","métaphore","gradation","répétition"],"menu_position":"bottom"}]},"types":["Menus"],"theory":"","explanation":""},{"id":"118202","name":"M3_poetique_eval_03","title":"<p><b>Coche la bonne définition de la métaphore.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_63cf5877-3af7-4cfb-a45b-456f5e844664","type":"label","metrics":{"x":80,"y":327,"wi