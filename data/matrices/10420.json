,"zindex":105},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_cae9607f-d6d6-4dae-ac51-872b117a293d","type":"checkbox","metrics":{"x":30,"y":180,"width":"40","height":"40","zindex":104},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_fbaade42-fc1e-4afa-d034-419f43edb5e3","type":"checkbox","metrics":{"x":30,"y":250,"width":"40","height":"40","zindex":103},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_21d55c25-cd4e-4233-d0c1-978fba09b5ba","type":"checkbox","metrics":{"x":30,"y":320,"width":"40","height":"40","zindex":102},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"118201","name":"M3_poetique_eval_04","title":"<p><b>Pour chaque phrase, indique si le mot en gras fait partie d<span style=\"font-family: Arial;\">’</span>une figure de style ou non.&nbsp;</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_44a13d89-0088-4a6b-ad35-1edbe0006329","type":"label","metrics":{"x":21,"y":297,"width":453,"fixed_width":"","height":46,"zindex":117},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\"><span style=\"font-family: Arial;\">d) Sa valise est près de la&nbsp;</span><b>porte</b><span style=\"font-family: Arial;\">, avec sa mallette,&nbsp;</span><br style=\"font-family: Arial;\"><span style=\"font-family: Arial;\"><font color=\"#FFFFFF\">__</font>son manteau et ses bottines.&nbsp;</span></p>"},{"id":"exelem_86775dbd-8e12-4b14-a95c-6f4492d9db21","type":"label","metrics":{"x":19,"y":253,"width":425,"fixed_width":"","height":23,"zindex":116},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\"><span style=\"font-family: Ari