"Liens"],"theory":"","explanation":""},{"id":"116719","name":"M3_gramm_ponct_discours_dir_05","title":"<p><b>Coche les phrases dans lesquelles on trouve un discours direct.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_6301eb22-7ee3-4134-d6b9-64ac65b69542","type":"checkbox","metrics":{"x":30,"y":285,"width":"35","height":"35","zindex":111},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_ade9783a-d3cc-4f43-d52e-c11815113d70","type":"checkbox","metrics":{"x":30,"y":245,"width":"35","height":"35","zindex":110},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_a8fbd6d7-4d61-4aa3-f19a-24ce9494dd61","type":"checkbox","metrics":{"x":30,"y":165,"width":"35","height":"35","zindex":108},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_54cdbf7c-9b1d-4d76-f8ab-d75bbead15f8","type":"checkbox","metrics":{"x":30,"y":325,"width":"35","height":"35","zindex":112},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_d13c89ba-d431-4a46-c815-a8dca7c9da74","type":"checkbox","metrics":{"x":30,"y":205,"width":"35","height":"35","zindex":109},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_801bcb2b-3b15-4dd2-c9d0-a5bdaaca124e","type":"checkbox","metrics":{"x":30,"y":125,"width":"35","height":"35","zindex":107},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_6752fdf2-6129-403d-f8af-6fc18405b744","type":"label","metrics":{"x":80,"y":330,"width":538,"fixed_width":"","height":46,"zindex":106},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">f) Je lui ai dit<span style=\"font-family: Arial;\">&nbsp;qu’il lui restait encore du temps pour décider du</span><br style=\"font-family: Arial;\"><span style=\"font-family: Arial;\">&nbsp; &nbsp;&nbsp;&nbsp;métier qu’elle aimerait occuper plus tard.</span></p>"},{"id":"exelem_f28c780a-03bc-458c-a8c1-78005516a06c","type":"label","metrics":{"x":80,"y":290,"width":600,"fixed_width":"600","height":23,"zindex":105},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">e) T<span style=\"font-family: Arial;\">remblante de froid, Marcelle a murmuré :&nbsp;« Je rentre. »</span></p>"},{"id":"exelem_258bb024-7836-4419-a13b-d588a5e1a342","type":"label","metrics":{"x":80,"y":250,"width":527,"fixed_width":"","height":23,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">d) Elle m<span style=\"font-family: Arial;\">’</span>a dit tout gentiment que rien n<span style=\"font-family: Arial;\">’</span>était encore décidé.</p>"},{"id":"exelem_4ca7a017-e876-4df1-c3a3-ac86fd9946b7","type":"label","metrics":{"x":80,"y":210,"width":540,"fixed_width":"","height":23,"zindex":103},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">c) « Arrêtez de gesticuler, madame », a demandé le dentiste.</p>"},{"id":"exelem_7cd4f911-f6d9-47b2-b990-43d2bdcdd272","type":"label","metrics":{"x":80,"y":170,"width":540,"fixed_width":"","height":23,"zindex":102},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">b) Je me demande ce que je peux répondre à cette question.</p>"},{"id":"exelem_a0af198e-9fd3-4e6d-8735-1eae9a0c8683","type":"label","metrics":{"x":80,"y":130,"width":468,"fixed_width":"","height":23,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">a) Martin a gémi :&nbsp;« J’ai terriblement mal au ventre! »</p>"}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"116720","name":"M3_gramm_ponct_discours_dir_06","title":"<p><b>Réécris les verbes de parole de chaque phrase.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_71af0740-632c-4c30-e748-9468f6a7a655","type":"input","metrics":{"x":300,"y":340,"width":"150","height":"30","zindex":109},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_34b19f3e-660e-4a6d-e84c-66aaea3ee058","type":"input","metrics":{"x":300,"y":270,"width":"150","height":"30","zindex":108},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_cacc71fd-23b0-4a4b-e72b-31cb0dc73086","type":"input","metrics":{"x":300,"y":200,"width":"150","height":"30","zindex":107},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_4a21e467-d0d1-4899-ba33-38615e3cff3e","type":"input","metrics":{"x":300,"y":130,"width":"150","height":"30","zindex":106},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_5bbeba55-3b36-41a9-b612-8aa099944dc0","type":"label","metrics":{"x":20,"y":310,"width":483,"fixed_width":"","height":44,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\"><font size=\"18\" style=\"font-size:18px;\">d) Sortant de la chambre de Kevin, Benjamin grommela : &nbsp; &nbsp; &nbsp;</font><br><font color=\"#FFFFFF\"><span style=\"font-family: Arial;\">__</span></font><font size=\"18\" style=\"font-size:18px;\">« Oui, oui... »</font></p>"},{"id":"exelem_25bc8e5f-6f51-4c7a-f213-dde360e76cf9","type":"label","metrics":{"x":20,"y":240,"width":428,"fixed_width":"","height":44,"zindex":103},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\"><font size=\"18\" style=\"font-size:18px;\">c) En entendant ses fils se quereller, Naïma s</font><span style=\"font-family: Arial; font-size: 18px;\">’</span><font size=\"18\" style=\"font-size:18px;\">informa :</font><br><font color=\"#FFFFFF\"><span style=\"font-family: Arial;\">__</span></font><font size=\"18\" style=\"font-size:18px;\">« Tout va bien là-haut ? »</font></p>"},{"id":"exelem_77c7df97-b1ec-4ed6-a07c-b53b3058aed2","type":"label","metrics":{"x":20,"y":170,"width":500,"fixed_width":"","height":21,"zindex":102},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\"><font size=\"18\" style=\"font-size:18px;\">b) « Tu n</font><span style=\"font-family: Arial; font-size: 18px;\">’</span><font size=\"18\" style=\"font-size:18px;\">as pas le droit de me dire quoi faire! » vociféra Kevin.</font></p>"},{"id":"exelem_3a0a6e87-f4d5-441f-8238-e62fb2141b92","type":"label","metrics":{"x":20,"y":100,"width":575,"fixed_width":"","height":44,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\"><font size=\"18\" style=\"font-size:18px;\">a) Benjamin sermonna son cousin :&nbsp;« Ne t’approche pas de Daphné, tu as</font><br><font color=\"#FFFFFF\">__</font><font size=\"18\" style=\"font-size:18px;\">compris? »</font></p>"}]},"types":["Réponses écrites"],"theory":"","explanation":""},{"id":"117988","nam