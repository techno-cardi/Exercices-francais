yles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_8198d28d-5dfb-4817-8051-a77b4bbdd5aa","type":"checkbox","metrics":{"x":20,"y":340,"width":"40","height":"40","zindex":107},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_4eae7773-cee2-4a97-bfcc-89c7ac8ca975","type":"checkbox","metrics":{"x":20,"y":160,"width":"40","height":"40","zindex":106},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_92e2ede3-9e96-43c2-ce9b-b7db863bad30","type":"label","metrics":{"x":70,"y":337,"width":562,"fixed_width":"","height":46,"zindex":105},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">e) Les verbes de parole sont toujours expressifs, car les propos<br>&nbsp;&nbsp;&nbsp; rapportés dans le discours direct ne sont jamais neutres.</p>"},{"id":"exelem_d46f345d-e9b9-4fd8-a31c-12a6a6f750a1","type":"label","metrics":{"x":70,"y":277,"width":542,"fixed_width":"","height":46,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">d) La phrase incise est couramment employée pour rapporter<br>&nbsp;&nbsp; &nbsp;des paroles.</p>"},{"id":"exelem_d1bb681f-1188-4fe5-b2c9-df1a2e6cd8e5","type":"label","metrics":{"x":70,"y":217,"width":560,"fixed_width":"","height":46,"zindex":103},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">c) Les verbes de paroles peuvent servir à introduire des propos<br>&nbsp; &nbsp; rapportés.&nbsp;</p>"},{"id":"exelem_2a30c6a7-af0f-476c-f420-bd9a04520b8c","type":"label","metrics":{"x":70,"y":157,"width":540,"fixed_width":"","height":46,"zindex":102},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">b) Le discours direct rapporte des paroles en les modifiant, si<br>&nbsp; &nbsp; c<span style=\"font-family: Arial;\">’</span>est nécessaire.</p>"},{"id":"exelem_1fad9e8b-397a-41d0-bb49-345cc4c87e80","type":"label","metrics":{"x":70,"y":97,"width":559,"fixed_width":"","height":46,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">a) Le discours direct rapporte toujours les paroles de quelqu’un<br>&nbsp; &nbsp; sans les changer.</p>"}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"116717","name":"M3_gramm_ponct_discours_dir_04","title":"<p><b>Relie les phrases contenant un discours direct à l’étiquette de droite.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_7baf7a7e-420e-42cd-f484-8820f4872cc8","type":"linkable","metrics":{"x":480,"y":212,"width":"150","height":"55","zindex":106},"linkable_type":"destination","linkable_aspect":"box","linkable_content":"text","text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":"Discours direct","image":{"media_id":"","src":"","mime_type":"","base64":"","width":0,"height":0,"proportional":true,"allow_zoom":false,"alt":"","title":"","metrics":{"x":"8","y":"8","width":"","height":"","zindex":1}},"linkable_anchor":"left"},{"id":"exelem_c7e4103b-a5a8-42e0-d28b-0a7491951a0a","type":"linkable","metrics":{"x":19,"y":204,"width":"350","height":"80","zindex":103},"linkable_type":"source","linkable_aspect":"button","linkable_content":"text","text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":"Adam m’a raconté que son cousin<br />avait participé au dernier tournoi de<br />poke