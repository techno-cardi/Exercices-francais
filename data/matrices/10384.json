15278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">c) Le serrant dans ses bras, elle entonna :&nbsp;« Au clair de la lune... »</p>"},{"id":"exelem_77c7df97-b1ec-4ed6-a07c-b53b3058aed2","type":"label","metrics":{"x":20,"y":170,"width":531,"fixed_width":"","height":23,"zindex":102},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"font-family: Arial;\">b) &nbsp;Au bord des larmes, Maëlle répondit :&nbsp;« Oui, mon chéri. »</p>"},{"id":"exelem_3a0a6e87-f4d5-441f-8238-e62fb2141b92","type":"label","metrics":{"x":20,"y":100,"width":534,"fixed_width":"","height":23,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">a) Son enfant balbutia pour la première fois :&nbsp;« Mamaman. »</p>"}]},"types":["Réponses écrites"],"theory":"","explanation":""},{"id":"116728","name":"M3_gramm_ponct_discours_dir_08","title":"<b><font color=\"#FFFFFF\">Réécris les phrases en ajoutant les guillemets au bon endroit pour encadrer les discours directs.</font></b>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_4c7bb408-d41c-4e22-b607-c2211e4b9fab","type":"input","metrics":{"x":62,"y":321,"width":"560","height":"32","zindex":113},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_4304b0d4-43c7-4276-f97b-ca7c650ed1ac","type":"input","metrics":{"x":58,"y":232,"width":"500","height":"32","zindex":112},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_6e2e0789-8320-42c0-d6b2-59d9d5ab587c","type":"input","metrics":{"x":60,"y":154,"width":"500","height":"32","zindex":111},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_9b328992-0f17-4ad8-9d82-d20588cb64d8","type":"label","metrics":{"x":62,"y":290,"width":549,"fixed_width":"","height":23,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">c) Mon propriétaire&nbsp;me lance : Je rénove&nbsp;le logement d’à côté.</p>"},{"id":"exelem_2a620eb0-1237-4be4-ba69-b70f3980a96f","type":"label","metrics":{"x":63,"y":198,"width":413,"fixed_width":"","height":27,"zindex":102},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p>b) Je suis enrhumée, leur répond la vendeuse.</p>"},{"id":"exelem_cfcc4100-abbe-4d1e-8a1c-9b066c704389","type":"label","metrics":{"x":64,"y":118,"width":389,"fixed_width":"","height":27,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p>a) L’ambulancier lui dit : As-tu mal à la tête?</p>"}]},"types":["Réponses écrites"],"theory":"","explanation":""},{"id":"116731","name":"M3_gramm_ponct_discours_dir_09","title":"<p><b>Complète l’énoncé suivant.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_634bb49f-0b21-4ebb-b0f9-f0c4dcbd5419","type":"label","metrics":{"x":64,"y":100,"width":382,"fixed_width":"","height":27,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p>L’usage des tirets montre le changement&nbsp;d’</p>"},{"id":"exelem_4acc6e24-b624-40e1-eb94-79920d405912","type":"input","metrics":{"x":447,"y":93,"width":"120","height":"32","zindex":102},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"