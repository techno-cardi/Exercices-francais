{"id":"exelem_81fbb8fd-7798-4b19-8cc4-fa6bead2432c","type":"checkbox","metrics":{"x":55,"y":264,"width":"40","height":"40","zindex":102},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_03108c7f-32e0-4049-de5a-fcaff1d41c27","type":"label","metrics":{"x":76,"y":101,"width":500,"fixed_width":"500","height":139,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p align=\"center\" style=\"color: rgb(17, 82, 120); font-family: Arial; font-size: 20px; font-weight: normal;\">J’ai trouvé une cabane ancestrale dans un joli quartier résidentiel. Quelle joie de pouvoir m’installer dans cette municipalité! Je pense déjà à toutes les activités que je pourrai faire dans mon nouveau secteur. Non loin du centre-ville, mon futur chez-moi me fera gagner en temps de déplacement.</p>"}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"118196","name":"M3_poetique_D1_BAO_08","title":"<p><b>Sélectionne le champ lexical de ce texte.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_596ddba2-6e15-4112-a651-e9ab87ba19f6","type":"label","metrics":{"x":513,"y":269,"width":74,"fixed_width":"","height":27,"zindex":107},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p>L’hôpital</p>"},{"id":"exelem_5a514f16-16e2-4677-bfd5-64c7d3155576","type":"checkbox","metrics":{"x":462,"y":259,"width":"40","height":"40","zindex":106},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":"1"},{"id":"exelem_01253a33-26a3-45d3-ea46-3bbb479e6fa6","type":"label","metrics":{"x":291,"y":267,"width":137,"fixed_width":"","height":27,"zindex":105},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p>L’ameublement</p>"},{"id":"exelem_7bb3238f-edc4-4c69-b866-9f9ced1450bb","type":"checkbox","metrics":{"x":242,"y":260,"wid