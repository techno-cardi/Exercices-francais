n":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">b) L’histoire devenait&nbsp;<b>une des plus mystérieuses qu’elle avait lue jusqu’à maintenant.</b></p>"},{"id":"exelem_fd094cb8-7909-41ad-8136-225b663db9fa","type":"input","metrics":{"x":35,"y":154,"width":"400","height":"32","zindex":102},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""},{"id":"exelem_7201e01d-2562-41fd-c500-94bd752ea533","type":"label","metrics":{"x":39,"y":109,"width":550,"fixed_width":"550","height":54,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">a)&nbsp;<span style=\"font-family: &quot;Arial Unicode MS&quot;, Arial, sans-serif;\">Observant la jeune fille, un passant était&nbsp;</span><b style=\"font-family: &quot;Arial Unicode MS&quot;, Arial, sans-serif;\">intrigué par sa lecture</b><span style=\"font-family: &quot;Arial Unicode MS&quot;, Arial, sans-serif;\">.</span></p>"}]},"types":["Réponses écrites"],"theory":"","explanation":""},{"id":"112952","name":"M3_gramm_fonctions_attr_S_10","title":"<p><b>Combien y a-t-il d’expansions attributs du sujet dans ce texte?</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_0385ac97-5e85-4832-cb31-4f3e66f538ba","type":"dropdown_menu","metrics":{"x":239,"y":314,"width":"128","height":"32","zindex":109},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"selected_index":-1,"options":["3","4","5","6","7"],"menu_position":"top"},{"id":"exelem_aff9a0c5-9251-4484-df91-e1103f0764d5","type":"label","metrics":{"x":61,"y":94,"width":550,"fixed_width":"550","height":209,"zindex":103},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Comme elle était curieuse, elle continua sa lecture malgré le mystère entourant le personnage, un homme au regard sombre. Peu à peu, elle devinait les secrets de cet homme attristé par une douleur qui semblait impossible à guérir. Plus sa lecture progressait, plus elle paraissait vraiment mal. Elle referma abruptement le carnet. Ses pensées devenaient claires. Ce qu’elle lisait dans son carnet, elle le voyait aussi dans la réalité. Elle comprit que chaque personne portait une histoire. Certaines histoires étaient invisibles, d’autres ne l’étaient pas.</p>"}]},"types":["Menus"],"theory":"","explanation":""}]}
