y: Arial; font-size: 20px; font-weight: normal;\">Des groupes de mots</p>"},{"id":"exelem_5601a6f0-8b68-4c6b-e89c-86d766da2f6e","type":"label","metrics":{"x":129,"y":128,"width":119,"fixed_width":"","height":23,"zindex":106},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Des pronoms</p>"},{"id":"exelem_0e0adfc2-a249-4f15-b8e8-272948ba7b13","type":"checkbox","metrics":{"x":400,"y":120,"width":"40","height":"40","zindex":105},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_e1777552-33ab-45f9-9c0a-08932c0b0724","type":"checkbox","metrics":{"x":401,"y":219,"width":"40","height":"40","zindex":104},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_5a0065ad-2a4b-4f2a-a892-c074a16fac80","type":"checkbox","metrics":{"x":80,"y":319,"width":"40","height":"40","zindex":103},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_d4b9df5a-9d58-4017-b902-6b110cb303a5","type":"checkbox","metrics":{"x":80,"y":221,"width":"40","height":"40","zindex":102},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_ffa8ce96-eda8-48cf-9a0d-277c859d0a02","type":"checkbox","metrics":{"x":81,"y":121,"width":"40","height":"40","zindex":101},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""}]},"types":["Cases à cocher"],"theory":"","explanation":""},{"id":"115869","name":"M3_gramm_jonctions_juxtaposition_03","title":"<p><b>Indique combien de signes de ponctuation servent à juxtaposer des éléments dans ce texte.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_6db03d45-cf67-445a-f35a-2445446eb3db","type":"label","metrics":{"x":172,"y":342,"width":210,"fixed_width":"210","height":23,"zindex":104},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">Signes de ponctuation :</p>"},{"id":"exelem_2a28479b-86fa-4c27-aa2e-9d7ec98422d8","type":"label","metrics":{"x":88,"y":109,"width":500,"fixed_width":"500","height":218,"zindex":103},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p align=\"center\">Caroline est hors d’elle&nbsp;: ses voisins Grégoire, Noé et Jacob lui ont encore joué un tour. Lorsqu’elle s’y attend le moins, ils sortent leur attirail de farces et attrapes pour se payer sa tête. Leur tour du jour, c’était de faire en sorte qu’elle glisse sur une pelure de banane, qu’elle tombe par terre, qu’elle enclenche le mécanisme et qu’elle se prenne une balloune d’eau en pleine tête. Super, comme on dit!</p>"},{"id":"exelem_0270da05-4054-49d4-80d7-a42fe2a04e2a","type":"input","metrics":{"x":385,"y":339,"width":"64","height":"32","zindex":102},"text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":""}]},"types":["Réponses écrites"],"theory":"","explanation":""},{"id":"115870","name":"M3_gramm_jonctions_juxtaposition_04","title":"<p><b>Coche les énoncés dans lesquels des éléments sont joints par juxtaposition.</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_dd0cffdc-2514-4674-8bb2-165a004341e9","type":"label","metrics":{"x":60,"y":180,"width":391,"fixed_width":"","height":23,"zindex":108},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\"><span style=\"font-family: Arial;\">b) Regarde devant toi, ne tourne pas la tête.</span></p>"},{"id":"exelem_ac04dc85-ba4d-406e-9101-6811a61a5771","type":"label","metrics":{"x":60,"y":240,"width":534,"fixed_width":"","height":23,"zindex":107},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\"><span style=\"font-family: Arial;\">c) Nous préparons un flan et nous soufflons&nbsp;des ballons.&nbsp;</span></p>"},{"id":"exelem_68da45c6-8b17-44c8-f0a7-e787f03c4257","type":"label","metrics":{"x":60,"y":300,"width":527,"fixed_width":"","height":46,"zindex":106},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\"><span style=\"font-family: Arial;\">d) Ses excès de colère, son anxiété et son pessimisme font</span><br style=\"font-family: Arial;\"><span style=\"font-family: Arial;\">&nbsp; &nbsp; fuir les gens autour d</span>’<span style=\"font-family: Arial;\">elle.&nbsp;</span></p>"},{"id":"exelem_3498e1a0-143e-433b-c686-da257c7d76e5","type":"checkbox","metrics":{"x":20,"y":180,"width":"20","height":"20","zindex":105},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_9af301ee-4073-4647-b80a-078975a7ffdf","type":"checkbox","metrics":{"x":20,"y":240,"width":"20","height":"20","zindex":104},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_f12cc486-c7b5-4f74-d463-d3d8cd481ebf","type":"checkbox","metrics":{"x":20,"y":300,"width":"20","height":"20","zindex":103},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_1dcc67c6-6d69-4d19-ccb0-48266c5b1681","type":"checkbox","metrics":{"x":20,"y":120,"width":"20","height":"20","zindex":102},"checkbox_styles":{"border_width":"md","color":"default"},"checked":false,"group":""},{"id":"exelem_26bdcaed-df4c-4c5c-d386-2aa57faaf363","type":"label","metrics":{"x":60,"y":120,"width":502,"fixed_width":"","height":23,"zindex":101},"text_format":{"font":"Arial","color":"#115278","size":22,"align":"left","html":true,"latex":false},"text":"<p style=\"color: #115278; font-family: Arial; font-size: 20px; font-weight: normal;\">a) La petite Emma regarde le défilé avec joie et bonheur.</p>"}]},"types":["Cases à cocher"],"theory":"<b>Rappel théorique</b><br>&nbsp;<br>La&nbsp;<font color=\"#FF8C00\"><b>coordination</b></font>&nbsp;et la<b>&nbsp;<font color=\"#FF8C00\">juxtaposition</font></b>&nbsp;servent à lier différents éléments, comme des groupes de mots qui ont la même fonction ou des phrases.<br>&nbsp;<br>La coordination lie des éléments à l’aide d’un&nbsp;<font color=\"#FF8C00\">coordonnant</font>&nbsp;(<i>et, ou, mais</i>, par exemple).<br>Ex. :&nbsp;<i>J’adore l’odeur de la lavande&nbsp;<font color=\"#FF8C00\">et</font>&nbsp;du romarin.&nbsp;</i><br><i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Il m’a demandé de lui téléphoner avant 10 heures&nbsp;<font color=\"#FF8C00\">ou</font>&nbsp;après 15 heures.&nbsp;</i><br>&nbsp;<br>La juxtaposition lie des éléments à l’aide d’un&nbsp;<font color=\"#FF8C00\">signe de ponctuation</font>&nbsp;plutôt qu’à l’aide d’un coordonnant. Le plus souvent, la virgule sera utilisée, mais le point-virgule et le deux-points peuvent aussi être employés.<br>Ex. :&nbsp;<i>J’aime l’odeur de la lavande<b><font color=\"#FF8C00\">,</font></b>&nbsp;je n’aime pas l’odeur du romarin.&nbsp;</i><br><i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Claude travaille&nbsp;<b><font color=\"#FF8C00\">;</font></b>&nbsp;Élise lit tranquillement le journal.</i><br><i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Dany est très fort<b>&nbsp;<font color=\"#FF8C00\">:</font></b>&nbsp;il peut soulever son cousin sans problème.</i><br>&nbsp;<br>Afin d’éviter les répétitions dans des phrases coordonnées, on peut effacer des éléments communs, qu’il s’agisse de mots identiques ou de groupes ayant la même fonction.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Verbe &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Verbe<br>Ex.&nbsp;:&nbsp;<i>Martine a mangé des bananes et Martine a mangé des framboises.&nbsp;</i><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;Sujet&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;compl. dir.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sujet&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Compl. dir.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>&nbsp;&nbsp; &nbsp; &nbsp; &nbsp;<i>Martine a mangé des bananes et des framboises.</i><br>&nbsp;<br>Si on efface un verbe répété, on utilise alors la&nbsp;<font color=\"#FF8C00\">virgule</font>&nbsp;pour marquer cet effacement.<br>Ex.&nbsp;:<i>&nbsp;Sébastien aime regarder le basketball et Joshua aime regarder le football.</i><br><i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Sébastien aime regarder le basketball et Joshua<font color=\"#FF8C00\"><b>,</b></font>&nbsp;le football.</i><br>&nbsp;<br>Dans des phrases coordonnées, des éléments communs peuvent être remplacés par des&nbsp;<font color=\"#FF8C00\">pronoms</font>&nbsp;ou des&nbsp;<font color=\"#FF8C00\">adverbes</font>&nbsp;(comme&nbsp;<i>aussi</i>,&nbsp;<i>ainsi</i>,&nbsp;<i>de même</i>,&nbsp;<i>pas</i>,&nbsp;<i>non plus</i>…).<br>Ex.&nbsp;:&nbsp;<i>Son discours est confus, et le discours de Jeanne est confus.</i><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i>Son discours est confus, et&nbsp;<font color=\"#FF8C00\">celui</font>&nbsp;de Jeanne&nbsp;<font color=\"#FF8C00\">aussi</font>.</i><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>Lorsqu’il y a une négation dans la phrase, on remplace&nbsp;<i>aussi</i>&nbsp;par&nbsp;<font color=\"#FF8C00\"><i>non plus</i></font>.<br>Ex.&nbsp;:&nbsp;<i>Christian ne regarde jamais de films romantiques, Steve&nbsp;<font color=\"#FF8C00\">non plus</font>.</i><br>&nbsp;<br>Quand des subordonnées sont coordonnées, le subordonnant&nbsp;<i><font color=\"#FF8C00\">que</font>&nbsp;</i>peut être effacé seulement si les sujets sont identiques.<br>Ex.&nbsp;:&nbsp;<i>Il faut&nbsp;<font color=\"#FF8C00\">que tu</font>&nbsp;t’assois et&nbsp;<font color=\"#FF8C00\">que tu</font>&nbsp;prennes une grande respiration.&nbsp;</i><br><i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Il faut&nbsp;<font color=\"#FF8C00\">que tu</font>&nbsp;t’assois et prennes une grande respiration.</i><br>&nbsp;","explanation":""},{"id":"115871","name":"M3_gramm_jonctions_juxtaposition_05","title":"<p><b>Relie chaque phrase à la sorte d’éléments juxtaposés qu</b><b style=\"caret-color: rgb(255, 255, 255); color: rgb(255, 255, 255); font-family: Arial, sans-serif;\">’</b><b>elle contient.&nbsp;</b></p>","canvas":{"width":650,"height":400,"elements":[{"id":"exelem_33abcfb2-ddc7-4ce1-921b-8a8be93ccc77","type":"linkable","metrics":{"x":520,"y":140,"width":"96","height":"35","zindex":109},"linkable_type":"destination","linkable_aspect":"box","linkable_content":"text","text_format":{"font":"Arial Unicode MS","color":"#115278","size":20,"align":"center","html":true,"latex":false},"input_styles":{"color":"default","border_width":"md"},"text":"GVinf","image":{"media_id":"","src":"","mime_type":"","base64":"","width":0,"height":0,"proportional":true,"allow_zoom":false,"alt":"","title":"","metrics":{"x":"8","y":"8","width":"","height":"","zindex":1}},"linkable_anchor":"left"},{"id":"exelem_d546d60e-a651-4bca-f457-0fff913627b9","type":"linkable","metrics":{"x":520,"y":190,"width":"96","height":"35","zindex":108},"linkable_type":"destination","linkable_aspect":"box","linkable_content":"text",