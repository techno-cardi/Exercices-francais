{
  "manifest_version": 3,
  "name": "Cardinal - Gestion des notes",
  "version": "0.8.1",
  "description": "Synchronise Gestion des notes avec Mozaïk et Formative.",
  "permissions": [
    "scripting",
    "tabs",
    "windows",
    "webRequest"
  ],
  "host_permissions": [
    "https://mozaikportail.ca/*",
    "https://apiaffaires.mozaikportail.ca/*",
    "https://techno-cardi.github.io/Exercices-francais/resultats/*",
    "https://app.formative.com/*",
    "https://svc.goformative.com/*"
  ],
  "background": {
    "service_worker": "background-v081.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://techno-cardi.github.io/Exercices-francais/resultats/*"
      ],
      "js": [
        "console-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mozaikportail.ca/*"
      ],
      "js": [
        "mozaik-ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.formative.com/formatives/*/results*"
      ],
      "js": [
        "formative-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Gestion des notes"
  }
}
